+  .app-shell > .dashboard-grid {
+    grid-column: 1;
+  }
+
+  .app-shell > .top-bar {
+    grid-row: 1;
+  }
+
+  .app-shell > .domain-nav {
+    grid-row: 2;
+  }
+
+  .app-shell > .dashboard-grid {
+    grid-row: 3;
+  }
+
+  .app-shell > .dashboard-grid {
+    border-radius: 18px;
+    padding: 14px;
+  }
+
+  .app-shell > .dashboard-grid .workbench-grid,
+  .app-shell > .dashboard-grid .workbench-shell.context-open .workbench-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .app-shell > .dashboard-grid .audit-row {
+    grid-template-columns: 1fr;
   }
 }
