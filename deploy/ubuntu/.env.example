# Copy this file to .env and replace the fake value locally.
# Never commit the resulting .env file.
ARK_API_KEY=fake-ark-key-1234567890

STAIX_MTCLAW_ROOT=/opt/staix-mtclaw
STAIX_MTCLAW_VENV=/opt/staix-mtclaw/.venv
STAIX_MTCLAW_CONFIG=/opt/staix-mtclaw/mtclaw-integration/config.local.json
STAIX_MTCLAW_TOOLS_DIR=/opt/staix-mtclaw/mtclaw-integration
STAIX_MTCLAW_FUNCTIONS_FILE=/opt/staix-mtclaw/mtclaw-integration/functions.jsonl
STAIX_MTCLAW_SCRIPTS_DIR=/opt/staix-mtclaw/mtclaw-integration/scripts
