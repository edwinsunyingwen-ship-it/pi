{
  "name": "@pi-agent/windows-client",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Staix desktop client for agent workflows.",
  "homepage": "https://aidocspro.com",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "dist:mac:x64:unsigned": "npm run build && electron-builder --mac dir --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.staix.desktop",
    "productName": "Staix",
    "executableName": "staix",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../package.json",
        "to": "pi-runtime/package.json"
      },
      {
        "from": "../../node_modules",
        "to": "pi-runtime/node_modules",
        "filter": [
          "**/*",
          "!@earendil-works/**",
          "!@pi-agent/**",
          "!pi-extension-*/**",
          "!pi-web-ui-example/**"
        ]
      },
      {
        "from": "../../packages/agent/dist",
        "to": "pi-runtime/packages/agent/dist"
      },
      {
        "from": "../../packages/agent/package.json",
        "to": "pi-runtime/packages/agent/package.json"
      },
      {
        "from": "../../packages/agent/dist",
        "to": "pi-runtime/node_modules/@earendil-works/pi-agent-core/dist"
      },
      {
        "from": "../../packages/agent/package.json",
        "to": "pi-runtime/node_modules/@earendil-works/pi-agent-core/package.json"
      },
      {
        "from": "../../packages/ai/dist",
        "to": "pi-runtime/packages/ai/dist"
      },
      {
        "from": "../../packages/ai/package.json",
        "to": "pi-runtime/packages/ai/package.json"
      },
      {
        "from": "../../packages/ai/dist",
        "to": "pi-runtime/node_modules/@earendil-works/pi-ai/dist"
      },
      {
        "from": "../../packages/ai/package.json",
        "to": "pi-runtime/node_modules/@earendil-works/pi-ai/package.json"
      },
      {
        "from": "../../packages/coding-agent/dist",
        "to": "pi-runtime/packages/coding-agent/dist"
      },
      {
        "from": "../../packages/coding-agent/package.json",
        "to": "pi-runtime/packages/coding-agent/package.json"
      },
      {
        "from": "../../packages/coding-agent/dist",
        "to": "pi-runtime/node_modules/@earendil-works/pi-coding-agent/dist"
      },
      {
        "from": "../../packages/coding-agent/package.json",
        "to": "pi-runtime/node_modules/@earendil-works/pi-coding-agent/package.json"
      },
      {
        "from": "../../packages/tui/dist",
        "to": "pi-runtime/packages/tui/dist"
      },
      {
        "from": "../../packages/tui/package.json",
        "to": "pi-runtime/packages/tui/package.json"
      },
      {
        "from": "../../packages/tui/dist",
        "to": "pi-runtime/node_modules/@earendil-works/pi-tui/dist"
      },
      {
        "from": "../../packages/tui/package.json",
        "to": "pi-runtime/node_modules/@earendil-works/pi-tui/package.json"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "staix",
      "signAndEditExecutable": false,
      "artifactName": "Staix-Setup-${version}-${arch}.${ext}",
      "publish": [
        {
          "provider": "generic",
          "url": "https://aidocspro.com/staix-updates/win"
        }
      ]
    },
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Staix-${version}-${arch}.${ext}",
      "publish": [
        {
          "provider": "generic",
          "url": "https://aidocspro.com/staix-updates/mac"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Staix",
      "executableName": "staix",
      "artifactName": "Staix-${version}-${arch}.${ext}",
      "synopsis": "Staix agent workflow desktop client",
      "description": "Staix desktop client with MTClaw professional routing and pi-agent runtime."
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Staix",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "customNsisBinary": {
        "url": "https://repo.huaweicloud.com/repository/toolkit/electron-builder-binaries/nsis-3.0.4.1/nsis-3.0.4.1.7z",
        "checksum": "VKMiizYdmNdJOWpRGz4trl4lD++BvYP2irAXpMilheUP0pc93iKlWAoP843Vlraj8YG19CVn0j+dCo/hURz9+Q==",
        "version": "3.0.4.1"
      },
      "customNsisResources": {
        "url": "https://repo.huaweicloud.com/repository/toolkit/electron-builder-binaries/nsis-resources-3.4.1/nsis-resources-3.4.1.7z",
        "checksum": "Dqd6g+2buwwvoG1Vyf6BHR1b+25QMmPcwZx40atOT57gH27rkjOei1L0JTldxZu4NFoEmW4kJgZ3DlSWVON3+Q==",
        "version": "3.4.1"
      }
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "marked": "^16.3.0",
    "pdfjs-dist": "5.4.394",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
